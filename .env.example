# Copy to .env.local for local dev, or set in Vercel Dashboard → Settings → Environment Variables
# DO NOT commit .env or .env.local to git

# Stripe — Test mode (sk_test_..., price_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxx
# Set AFTER you create the webhook endpoint in Stripe Dashboard (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Resend — for sending notification emails
RESEND_API_KEY=re_xxxxxxxxxxxx
# Inbox that receives pending + paid notifications
NOTIFICATION_EMAIL=you@example.com
# From-address. Use onboarding@resend.dev until grcreport.com is verified in Resend.
FROM_EMAIL=GRC Stack Search <onboarding@resend.dev>

# CORS — comma-separated list of allowed origins (Webflow site + preview)
ALLOWED_ORIGINS=https://stack.grcreport.com,https://stack-grcreport.webflow.io

# Public-facing site URL — used for Stripe success_url and cancel_url
PUBLIC_SITE_URL=https://stack.grcreport.com
